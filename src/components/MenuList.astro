---
/**
 * A Bulma menu list; holds MenuItems.
 * https://bulma.io/documentation/components/menu/
 *
 * Usage:
 *   <MenuList>
 *     <MenuItem label="Dashboard" href="/" />
 *   </MenuList>
 */

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
const classes = ["menu-list", className].filter(Boolean).join(" ");
---

<ul class={classes} {...rest}>
  <slot />
</ul>
