---
type Props = {
  color?: "link" | "primary" | "info" | "success" | "warning" | "danger";
  light?: boolean;
  dismissible?: boolean;
  class?: string;
  [key: string]: unknown;
};

const { color, light, dismissible, class: className, ...rest } = Astro.props;

const classes = [
  "notification",
  color && `is-${color}`,
  light && "is-light",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes} {...rest}>
  {
    dismissible && (
      <button class="delete" onclick="this.parentElement.remove()" />
    )
  }
  <slot />
</div>
