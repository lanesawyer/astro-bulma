---
import type { Polymorphic } from "astro/types";

type Color =
  | "primary"
  | "link"
  | "info"
  | "success"
  | "warning"
  | "danger"
  | "light"
  | "dark"
  | "white"
  | "black";

type Size = "normal" | "medium" | "large" | "small";

type Element = "span" | "a" | "button";

type Props<Tag extends Element = "span"> = Polymorphic<{
  as: Tag;
}> & {
  color?: Color;
  size?: Size;
  light?: boolean;
  rounded?: boolean;
  /** Renders as a delete/close button with no slot content */
  isDelete?: boolean;
  title?: string;
  class?: string;
};

const {
  as: Tag = "span",
  color,
  size,
  light,
  rounded,
  isDelete,
  title,
  class: className,
  ...rest
} = Astro.props as Props<Element>;

const classes = [
  "tag",
  color && `is-${color}`,
  light && "is-light",
  size && `is-${size}`,
  rounded && "is-rounded",
  isDelete && "is-delete",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<Tag
  class={classes}
  title={title}
  type={Tag === "button" ? "button" : undefined}
  {...rest}>{isDelete ? null : <slot />}</Tag
>
