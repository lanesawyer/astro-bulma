---
import { Image as AstroImage } from "astro:assets";

type FixedSize =
  "16x16" | "24x24" | "32x32" | "48x48" | "64x64" | "96x96" | "128x128";
type Ratio =
  | "square"
  | "1by1"
  | "5by4"
  | "4by3"
  | "3by2"
  | "5by3"
  | "16by9"
  | "2by1"
  | "3by1"
  | "4by5"
  | "3by4"
  | "2by3"
  | "3by5"
  | "9by16"
  | "1by2"
  | "1by3";

interface Props {
  /** A URL, path, or data URI; or an imported image, which Astro optimizes */
  src: string | ImageMetadata;
  alt: string;
  size?: FixedSize;
  ratio?: Ratio;
  rounded?: boolean;
  fullwidth?: boolean;
  /** Extra classes on the <figure> wrapper */
  class?: string;
  /** Extra inline styles on the <figure> wrapper */
  style?: string;
  /** Extra inline styles applied directly to the <img> */
  imgStyle?: string;
}

const {
  src,
  alt,
  size,
  ratio,
  rounded,
  fullwidth,
  class: className,
  style,
  imgStyle,
} = Astro.props;

const figureClasses = [
  "image",
  size && `is-${size}`,
  ratio && `is-${ratio}`,
  rounded && "is-rounded",
  fullwidth && "is-fullwidth",
  className,
]
  .filter(Boolean)
  .join(" ");

// Only imported images go through Astro's <Image>: their dimensions are known at build time.
// A string src could be a data URI, a path behind auth, or a remote URL that Astro would have
// to fetch on every render to infer its size, so it gets a plain <img>, sized when `size` is set.
const px = size ? Number(size.split("x")[0]) : undefined;
---

<figure class={figureClasses} style={style}>
  {typeof src === "string" ? (
    <img
      src={src}
      alt={alt}
      width={px}
      height={px}
      loading="lazy"
      style={imgStyle}
    />
  ) : (
    <AstroImage src={src} alt={alt} style={imgStyle} />
  )}
</figure>
