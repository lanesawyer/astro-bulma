{
  "name": "astro-bulma",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@12.6.0",
  "description": "Astro component library wrapping Bulma CSS",
  "keywords": [
    "astro",
    "bulma",
    "component-library",
    "astro-component"
  ],
  "license": "(GPL-3.0-only OR MIT)",
  "homepage": "https://github.com/lanesawyer/astro-bulma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanesawyer/astro-bulma.git"
  },
  "bugs": {
    "url": "https://github.com/lanesawyer/astro-bulma/issues"
  },
  "files": [
    "src/"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "changelog": "git-cliff --output CHANGELOG.md",
    "prepublishOnly": "pnpm check && pnpm lint && pnpm test --passWithNoTests",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docs:dev": "astro --root docs dev",
    "docs:build": "astro --root docs build",
    "docs:preview": "astro --root docs preview",
    "check": "astro check",
    "check:docs": "astro --root docs check",
    "lint": "oxlint src --deny-warnings",
    "fmt": "oxlint src --fix && prettier --write \"src/**/*.astro\"",
    "fmt:check": "prettier --check \"src/**/*.astro\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "bulma": "1.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.42.3",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@vitest/coverage-istanbul": "5.0.1",
    "astro": "7.3.4",
    "git-cliff": "2.14.2",
    "oxlint": "1.85.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "12.6.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "volta": {
    "node": "26.10.0",
    "pnpm": "12.6.0"
  }
}
